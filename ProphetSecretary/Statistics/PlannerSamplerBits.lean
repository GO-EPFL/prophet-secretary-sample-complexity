import ProphetSecretary.Statistics.PlannerNumericBits
import ProphetSecretary.Statistics.PlannerSamplerRationalHeight

/-!
# Binary evaluation of categorical prefixes

These expressions are generated by the transition sampler. The binary
evaluator preserves their exact rational comparison values.
-/

namespace ProphetSecretary.Statistics
open ProphetSecretary.Analysis ArithmeticExpression

variable {n : ℕ}

theorem countedPlannerFirstPrefix_binary_correct (l : List (Fin n)) (i : Fin n)
    (p : Fin n → BinaryFraction) (B : ℕ) (hB : 2 ≤ B)
    (hp : ∀ j, 0 < binaryWordValue (p j).denominator ∧ (p j).width ≤ B+1 ∧ RationalHeight (p j).value B) :
    let e := (countedPlannerFirstPrefix l i).1
    let q := countedBinaryEval p e
    let W := 1+l.length*(16+24*l.length)
    q.1.value = eval (fun j => (p j).value) e ∧
      q.2 ≤ W*(3500*((B+1)*W+2)^3) := by
  have he : LiteralsBounded B (countedPlannerFirstPrefix l i).1 := by
    rw [countedPlannerFirstPrefix_value]
    exact (plannerFirstPrefixExpression_literals l i).mono hB
  exact ⟨(countedBinaryEval_correct p B hp _ he).1, binaryExpression_work_le p B _ hp _ he
    (by rw [countedPlannerFirstPrefix_value]; exact work_plannerFirstPrefixExpression_le l i)⟩

theorem countedPlannerUniformPrefix_binary_correct (l : List (Fin n)) (i : Fin n)
    (B : ℕ) (hB : l.length ≤ 2^B) :
    let e := (countedPlannerUniformPrefix l i).1
    let q := countedBinaryEval (fun _ => BinaryFraction.ofInt 0) e
    let W := 1+4*l.length
    q.1.value = eval (fun _ => (0:ℚ)) e ∧
      q.2 ≤ W*(3500*((B+1)*W+2)^3) := by
  let p := fun _ : Fin n => BinaryFraction.ofInt 0
  have hp (j : Fin n) : 0 < binaryWordValue (p j).denominator ∧ (p j).width ≤ B+1 ∧ RationalHeight (p j).value B := by
    refine ⟨(show 0 < binaryWordValue [true] by decide),BinaryFraction.ofInt_width 0 B (Nat.zero_le _),?_⟩
    rw [show (p j).value=0 by simp [p,BinaryFraction.ofInt_value]]
    exact rationalHeight_zero.mono (Nat.zero_le _)
  have he : LiteralsBounded B (countedPlannerUniformPrefix l i).1 := by
    rw [countedPlannerUniformPrefix_value]
    apply literalsBounded_sumList
    intro j _
    exact ⟨Nat.succ_le_of_lt (by positivity),hB⟩
  let e := (countedPlannerUniformPrefix l i).1
  have h := countedBinaryEval_correct p B hp e he
  have hc : (fun j => (p j).value) = (fun _ : Fin n => (0:ℚ)) := by
    funext j
    exact BinaryFraction.ofInt_value 0
  change (countedBinaryEval p e).1.value = eval (fun _ => (0:ℚ)) e ∧
    (countedBinaryEval p e).2 ≤ (1+4*l.length)*(3500*((B+1)*(1+4*l.length)+2)^3)
  exact ⟨h.1.trans (congrArg (fun f => eval f e) hc),
    binaryExpression_work_le p B (1+4*l.length) hp e he (countedPlannerUniformPrefix_expression_work l i)⟩

end ProphetSecretary.Statistics
