import ProphetSecretary.Model.FirstArrival
import ProphetSecretary.Model.ScalarBands

/-!
# Deterministic-time state laws

Fix an interior time and an unseen set excluding the pending candidate. Seen clocks
are generated by `t*v`; unseen clocks by `t+(1-t)*v`. The candidate clock remains latent.
The state-restricted law is this explicit independent-clock coupling times its state
mass, before any normalization or conditional-expectation argument.
-/

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal BigOperators Classical

namespace ProphetSecretary.Model.Instance

lemma uniformClock_map_headClock {t : ℝ} (ht : 0 < t) :
    uniformClock.map (fun v => t * v) = ENNReal.ofReal t⁻¹ • volume.restrict (Icc (0 : ℝ) t) := by
  have hp : (fun v : ℝ => t * v) ⁻¹' Icc (0 : ℝ) t = Icc (0 : ℝ) 1 := by
    ext v
    simp only [mem_preimage, mem_Icc]
    constructor <;> rintro ⟨h0, h1⟩ <;> constructor <;> nlinarith
  have hv : volume.map (fun v : ℝ => t * v) = ENNReal.ofReal t⁻¹ • volume := by
    rw [Real.map_volume_mul_left ht.ne', abs_of_pos (inv_pos.mpr ht)]
  unfold uniformClock
  rw [← hp, ← Measure.restrict_map (f := fun v : ℝ => t * v) (measurable_const.mul measurable_id) measurableSet_Icc,
    hv, Measure.restrict_smul]

lemma uniformClock_restrict_Iio {t : ℝ} (ht0 : 0 < t) (ht1 : t ≤ 1) :
    uniformClock.restrict (Iio t) = ENNReal.ofReal t • uniformClock.map (fun v => t * v) := by
  rw [restrict_Iio_eq_restrict_Iic, uniformClock_map_headClock ht0, smul_smul,
    ← ENNReal.ofReal_mul ht0.le, mul_inv_cancel₀ ht0.ne', ENNReal.ofReal_one, one_smul]
  have hi : Iic t ∩ Icc (0 : ℝ) 1 = Icc (0 : ℝ) t := by
    ext v
    constructor
    · rintro ⟨hvt, hv0, _⟩
      exact ⟨hv0, hvt⟩
    · rintro ⟨hv0, hvt⟩
      exact ⟨hvt, hv0, hvt.trans ht1⟩
  exact (Measure.restrict_restrict measurableSet_Iic).trans (congrArg volume.restrict hi)


end ProphetSecretary.Model.Instance

namespace ProphetSecretary.Model

open Instance

variable {n : ℕ}

def clockSide (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (j : Fin n) : Set ℝ :=
  if j = i then univ else if j ∈ A then Ici t else Iio t

noncomputable def splitClockMass (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (j : Fin n) : ℝ≥0∞ :=
  if j = i then 1 else if j ∈ A then ENNReal.ofReal (1 - t) else ENNReal.ofReal t

noncomputable def clockStateMass (A : Finset (Fin n)) (i : Fin n) (t : ℝ) : ℝ≥0∞ :=
  ∏ j, splitClockMass A i t j

def splitClock (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (j : Fin n) (v : ℝ) : ℝ :=
  if j = i then v else if j ∈ A then tailClock t v else t * v

def splitClocks (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (v : Fin n → ℝ) : Fin n → ℝ :=
  fun j => splitClock A i t j (v j)

lemma measurable_splitClock (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (j : Fin n) :
    Measurable (splitClock A i t j) := by
  unfold splitClock
  split_ifs
  · exact measurable_id
  · exact measurable_tailClock t
  · exact measurable_const.mul measurable_id

lemma measurable_splitClocks (A : Finset (Fin n)) (i : Fin n) (t : ℝ) : Measurable (splitClocks A i t) :=
  measurable_pi_lambda _ (fun j => (measurable_splitClock A i t j).comp (measurable_pi_apply j))

lemma measurableSet_clockSide (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (j : Fin n) :
    MeasurableSet (clockSide A i t j) := by
  unfold clockSide
  split_ifs
  · exact MeasurableSet.univ
  · exact measurableSet_Ici
  · exact measurableSet_Iio

lemma otherUnseen_eq_pi_clockSide (A : Finset (Fin n)) (i : Fin n) (hAi : i ∉ A) (t : ℝ) :
    {u : Fin n → ℝ | otherUnseen u i t = A} = univ.pi (clockSide A i t) := by
  ext u
  constructor
  · intro h j _
    by_cases hji : j = i
    · simp only [clockSide, if_pos hji, mem_univ]
    · by_cases hjA : j ∈ A
      · have hj : j ∈ otherUnseen u i t := by rw [h]; exact hjA
        have hge : t ≤ u j := (Finset.mem_filter.mp hj).2
        simpa only [clockSide, if_neg hji, if_pos hjA, mem_Ici] using hge
      · have hlt : u j < t := by
          by_contra hnot
          have hj : j ∈ otherUnseen u i t := by simp [otherUnseen, hji, le_of_not_gt hnot]
          exact hjA (h ▸ hj)
        simpa only [clockSide, if_neg hji, if_neg hjA, mem_Iio] using hlt
  · intro h
    apply Finset.ext
    intro j
    by_cases hji : j = i
    · subst j
      simp [otherUnseen, hAi]
    · by_cases hjA : j ∈ A
      · have hge : t ≤ u j := by simpa only [clockSide, if_neg hji, if_pos hjA, mem_Ici] using h j (mem_univ j)
        simp [otherUnseen, hji, hjA, hge]
      · have hlt : u j < t := by simpa only [clockSide, if_neg hji, if_neg hjA, mem_Iio] using h j (mem_univ j)
        simp [otherUnseen, hji, hjA, not_le.mpr hlt]

lemma measurableSet_otherUnseen_eq (A : Finset (Fin n)) (i : Fin n) (hAi : i ∉ A) (t : ℝ) :
    MeasurableSet {u : Fin n → ℝ | otherUnseen u i t = A} := by
  rw [otherUnseen_eq_pi_clockSide A i hAi t]
  exact MeasurableSet.univ_pi (measurableSet_clockSide A i t)

lemma uniformClock_restrict_side (A : Finset (Fin n)) (i : Fin n) {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
    (j : Fin n) :
    Instance.uniformClock.restrict (clockSide A i t j) =
      splitClockMass A i t j • Instance.uniformClock.map (splitClock A i t j) := by
  unfold clockSide splitClockMass splitClock
  split_ifs
  · simp
  · exact uniformClock_restrict_Ici ht0.le ht1
  · exact Instance.uniformClock_restrict_Iio ht0 ht1.le

/-- Exact product-law factorization for a fixed observed/unseen state. -/
lemma clocksLaw_restrict_state (A : Finset (Fin n)) (i : Fin n) (hAi : i ∉ A)
    {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1) :
    (Instance.clocksLaw n).restrict {u | otherUnseen u i t = A} =
      clockStateMass A i t • (Instance.clocksLaw n).map (splitClocks A i t) := by
  let ν : Fin n → Measure ℝ := fun j => Instance.uniformClock.map (splitClock A i t j)
  haveI : ∀ j, IsProbabilityMeasure (ν j) := fun j => Measure.isProbabilityMeasure_map (measurable_splitClock A i t j).aemeasurable
  haveI : ∀ j, IsFiniteMeasure (splitClockMass A i t j • ν j) := by
    intro j
    constructor
    simp only [Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
    unfold splitClockMass
    split_ifs <;> simp
  have hmap : (Instance.clocksLaw n).map (splitClocks A i t) = Measure.pi ν :=
    Measure.pi_map_pi (fun j => (measurable_splitClock A i t j).aemeasurable)
  change (Measure.pi (fun _ : Fin n => Instance.uniformClock)).map (splitClocks A i t) = Measure.pi ν at hmap
  rw [otherUnseen_eq_pi_clockSide A i hAi t, Instance.clocksLaw, Measure.restrict_pi_pi (fun _ : Fin n => Instance.uniformClock) (clockSide A i t)]
  simp_rw [uniformClock_restrict_side A i ht0 ht1]
  rw [hmap]
  apply Measure.pi_eq
  intro s hs
  simp only [Measure.smul_apply, Measure.pi_pi, smul_eq_mul]
  change (∏ j, splitClockMass A i t j) * (∏ j, ν j (s j)) = ∏ j, splitClockMass A i t j * ν j (s j)
  exact (Finset.prod_mul_distrib).symm

lemma clockStateMass_le_one (A : Finset (Fin n)) (i : Fin n) {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    clockStateMass A i t ≤ 1 := by
  have hj (j : Fin n) : splitClockMass A i t j ≤ 1 := by
    unfold splitClockMass
    split_ifs
    · rfl
    · simpa only [ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal (sub_le_self (1 : ℝ) ht0)
    · simpa only [ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal ht1
  calc
    _ ≤ ∏ _j : Fin n, (1 : ℝ≥0∞) := Finset.prod_le_prod (fun _ _ => bot_le) (fun j _ => hj j)
    _ = 1 := by simp

variable {Seed : Type*} [MeasurableSpace Seed]

def splitWorld (A : Finset (Fin n)) (i : Fin n) (t : ℝ) (ω : World n Seed) : World n Seed :=
  (ω.1, (splitClocks A i t ω.2.1, ω.2.2))

lemma measurable_splitWorld (A : Finset (Fin n)) (i : Fin n) (t : ℝ) : Measurable (@splitWorld n Seed A i t) :=
  measurable_fst.prodMk (((measurable_splitClocks A i t).comp (measurable_fst.comp measurable_snd)).prodMk
    (measurable_snd.comp measurable_snd))

/-- The complete state law is derived before conditioning. Values, zeros, identities
and independent auxiliary randomness remain present; the pending candidate is latent. -/
lemma Instance.worldLaw_restrict_state (P : Instance n) (ν : Measure Seed) [IsProbabilityMeasure ν]
    (A : Finset (Fin n)) (i : Fin n) (hAi : i ∉ A) {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1) :
    (P.worldLaw ν).restrict {ω : World n Seed | otherUnseen ω.2.1 i t = A} =
      clockStateMass A i t • (P.worldLaw ν).map (splitWorld A i t) := by
  have he : {ω : World n Seed | otherUnseen ω.2.1 i t = A} =
      (univ : Set (Fin n → ℝ)) ×ˢ ({u : Fin n → ℝ | otherUnseen u i t = A} ×ˢ (univ : Set Seed)) := by
    ext ω
    simp
  have hclock : MeasurePreserving (splitClocks A i t) (clocksLaw n)
      ((clocksLaw n).map (splitClocks A i t)) := ⟨measurable_splitClocks A i t, rfl⟩
  have hmp : MeasurePreserving (splitWorld A i t) (P.worldLaw ν)
      (P.valuesLaw.prod (((clocksLaw n).map (splitClocks A i t)).prod ν)) :=
    (MeasurePreserving.id P.valuesLaw).prod (hclock.prod (MeasurePreserving.id ν))
  rw [he, worldLaw, ← Measure.prod_restrict, Measure.restrict_univ,
    ← Measure.prod_restrict, Measure.restrict_univ, clocksLaw_restrict_state A i hAi ht0 ht1,
    Measure.prod_smul_left, Measure.prod_smul_right]
  exact congrArg (fun mLaw : Measure (World n Seed) => clockStateMass A i t • mLaw) hmp.map_eq.symm

end ProphetSecretary.Model
