import ProphetSecretary.Probability.DyadicUniform
import Mathlib.Data.Fintype.EquivFin
import Mathlib.MeasureTheory.Constructions.Pi

/-!
# A dyadic uniform from a bounded fair-bit reservoir

The binary decoder reads one independent Boolean at each recursive level.
Its law is proved from the literal product of fair-bit laws, and its rational
output has the same law as the analytical downward rounding of a uniform.
-/

open MeasureTheory
open scoped ENNReal

namespace ProphetSecretary.Probability

def fairBitsIndex : (b : ℕ) → (Fin b → Bool) → Fin (2 ^ b)
  | 0, _ => ⟨0, by norm_num⟩
  | b + 1, bits =>
      let q := fairBitsIndex b (fun i => bits i.succ)
      ⟨2 * q.val + if bits 0 then 1 else 0, by
        have hq := q.isLt
        rw [pow_succ]
        split <;> omega⟩

lemma fairBitsIndex_injective (b : ℕ) : Function.Injective (fairBitsIndex b) := by
  induction b with
  | zero => intro f g _; funext i; exact Fin.elim0 i
  | succ b ih =>
    intro f g h
    have hv := congrArg Fin.val h
    simp only [fairBitsIndex] at hv
    have hb : f 0 = g 0 := by
      cases hf : f 0 <;> cases hg : g 0 <;> simp_all <;> omega
    have htail : fairBitsIndex b (fun i => f i.succ) = fairBitsIndex b (fun i => g i.succ) := by
      apply Fin.ext
      simp only [hb] at hv
      omega
    have ht := ih htail
    funext i
    exact Fin.cases hb (fun j => congrFun ht j) i

lemma fairBitsIndex_bijective (b : ℕ) : Function.Bijective (fairBitsIndex b) := by
  apply (Fintype.bijective_iff_injective_and_card _).2
  exact ⟨fairBitsIndex_injective b, by simp⟩

def countedFairBitsIndex : (b : ℕ) → (Fin b → Bool) → Fin (2 ^ b) × ℕ
  | 0, _ => (⟨0, by norm_num⟩, 0)
  | b + 1, bits =>
      let q := countedFairBitsIndex b (fun i => bits i.succ)
      (⟨2 * q.1.val + if bits 0 then 1 else 0, by
        have hq := q.1.isLt
        rw [pow_succ]
        split <;> omega⟩, q.2 + 1)

lemma countedFairBitsIndex_value (b : ℕ) (bits : Fin b → Bool) :
    (countedFairBitsIndex b bits).1 = fairBitsIndex b bits := by
  induction b with
  | zero => rfl
  | succ b ih =>
    apply Fin.ext
    simp [countedFairBitsIndex, fairBitsIndex, ih]

lemma countedFairBitsIndex_reads (b : ℕ) (bits : Fin b → Bool) :
    (countedFairBitsIndex b bits).2 = b := by
  induction b with
  | zero => rfl
  | succ b ih => simp [countedFairBitsIndex, ih]

def countedDyadicUniform (b : ℕ) (bits : Fin b → Bool) : ℚ × ℕ :=
  let q := countedFairBitsIndex b bits
  (gridPoint (2 ^ b) q.1, q.2)

lemma countedDyadicUniform_reads (b : ℕ) (bits : Fin b → Bool) :
    (countedDyadicUniform b bits).2 = b := countedFairBitsIndex_reads b bits

noncomputable def fairBitLaw : Measure Bool := (PMF.uniformOfFintype Bool).toMeasure

instance fairBitLaw_probability : IsProbabilityMeasure fairBitLaw := by
  unfold fairBitLaw
  infer_instance

@[simp] lemma fairBitLaw_singleton (v : Bool) : fairBitLaw {v} = (2 : ℝ≥0∞)⁻¹ := by
  simp [fairBitLaw]

noncomputable def fairBitVectorLaw (b : ℕ) : Measure (Fin b → Bool) :=
  Measure.pi (fun _ => fairBitLaw)

instance fairBitVectorLaw_probability (b : ℕ) : IsProbabilityMeasure (fairBitVectorLaw b) := by
  unfold fairBitVectorLaw
  infer_instance

lemma fairBitVectorLaw_singleton (b : ℕ) (bits : Fin b → Bool) :
    fairBitVectorLaw b {bits} = ((2 : ℝ≥0∞)⁻¹) ^ b := by
  simp [fairBitVectorLaw, Measure.pi_singleton]

/-- Every dyadic index is generated by exactly one bit vector. -/
theorem map_fairBitsIndex (b : ℕ) :
    (fairBitVectorLaw b).map (fairBitsIndex b) =
      uniformGridIndexLaw (2 ^ b) (by positivity) := by
  apply Measure.ext_of_singleton
  intro j
  obtain ⟨bits, hbits⟩ := (fairBitsIndex_bijective b).2 j
  have hfiber : (fairBitsIndex b) ⁻¹' {j} = {bits} := by
    ext v
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    rw [← hbits]
    exact (fairBitsIndex_injective b).eq_iff
  rw [Measure.map_apply (measurable_of_countable _) (measurableSet_singleton _),
    hfiber, fairBitVectorLaw_singleton]
  unfold uniformGridIndexLaw
  simp [Nat.cast_pow, ENNReal.inv_pow]

/-- The executable rational output realizes the same rounded-uniform law. -/
theorem map_countedDyadicUniform (b : ℕ) :
    (fairBitVectorLaw b).map (fun bits => ((countedDyadicUniform b bits).1 : ℝ)) =
      Model.Instance.uniformClock.map (uniformGridRound (2 ^ b) (by positivity)) := by
  have hfun : (fun bits => ((countedDyadicUniform b bits).1 : ℝ)) =
      (gridPoint (K := ℝ) (2 ^ b)) ∘ fairBitsIndex b := by
    funext bits
    simp [countedDyadicUniform, countedFairBitsIndex_value, gridPoint_ratCast]
  rw [hfun, ← Measure.map_map (measurable_of_countable _) (measurable_of_countable _), map_fairBitsIndex]
  rw [← map_uniformGridIndex (2 ^ b) (by positivity),
    Measure.map_map (measurable_of_countable _) (measurable_uniformGridIndex _ _)]
  rfl

end ProphetSecretary.Probability
