import Mathlib.MeasureTheory.Measure.GiryMonad
import Mathlib.MeasureTheory.Constructions.Projective

/-!
# Finite evaluation laws determine a random measure

The measurable structure on measures is generated by evaluation on measurable
regions. Its full probability law is therefore determined by the joint laws
of every finite family of evaluations. No ordering of points is introduced.
-/

open MeasureTheory Set
open scoped ENNReal

namespace ProphetSecretary.Probability

abbrev MeasurableRegion (A : Type*) [MeasurableSpace A] := {S : Set A // MeasurableSet S}

def measureEvaluations {A : Type*} [MeasurableSpace A] (μ : Measure A) : MeasurableRegion A → ℝ≥0∞ :=
  fun S => μ S.1

lemma measurable_measureEvaluations {A : Type*} [MeasurableSpace A] :
    Measurable (measureEvaluations (A := A)) :=
  measurable_pi_lambda _ (fun S => Measure.measurable_coe S.2)

lemma measureEvaluations_comap {A : Type*} [MeasurableSpace A] :
    MeasurableSpace.comap (measureEvaluations (A := A)) inferInstance =
      (inferInstance : MeasurableSpace (Measure A)) := by
  rw [MeasurableSpace.comap_process_pi]
  change (⨆ S : MeasurableRegion A, MeasurableSpace.comap (fun μ : Measure A => μ S.1) (borel ℝ≥0∞)) = _
  rw [iSup_subtype]
  rfl

theorem randomMeasure_law_eq_of_finite_evaluations {A : Type*} [MeasurableSpace A]
    (μ ν : Measure (Measure A)) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ I : Finset (MeasurableRegion A),
      μ.map (fun m => fun S : I => m S.1.1) = ν.map (fun m => fun S : I => m S.1.1)) : μ = ν := by
  let e := measureEvaluations (A := A)
  have he : Measurable e := measurable_measureEvaluations
  have hfinite (I : Finset (MeasurableRegion A)) :
      (μ.map e).map I.restrict = (ν.map e).map I.restrict := by
    rw [Measure.map_map (by fun_prop) he,Measure.map_map (by fun_prop) he]
    exact h I
  have hμ : IsProjectiveLimit (μ.map e) (fun I => (μ.map e).map I.restrict) := fun _ => rfl
  have hν : IsProjectiveLimit (ν.map e) (fun I => (μ.map e).map I.restrict) := fun I => (hfinite I).symm
  have hmap : μ.map e = ν.map e := hμ.unique hν
  ext T hT
  have hSpace : MeasurableSpace.comap e inferInstance = (inferInstance : MeasurableSpace (Measure A)) :=
    measureEvaluations_comap
  have hT' : MeasurableSet[MeasurableSpace.comap e inferInstance] T := hSpace.symm ▸ hT
  obtain ⟨U,hU,rfl⟩ := hT' 
  rw [← Measure.map_apply he hU,← Measure.map_apply he hU,hmap]

/-- For laws concentrated on finite measures, real evaluation vectors also
suffice; the finiteness hypotheses justify reconstruction from `toReal`. -/
theorem randomMeasure_law_eq_of_finite_real_evaluations {A : Type*} [MeasurableSpace A]
    (μ ν : Measure (Measure A)) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (hμ : ∀ᵐ m ∂μ, m univ < ⊤) (hν : ∀ᵐ m ∂ν, m univ < ⊤)
    (h : ∀ I : Finset (MeasurableRegion A),
      μ.map (fun m => fun S : I => m.real S.1.1) = ν.map (fun m => fun S : I => m.real S.1.1)) : μ = ν := by
  have hrecover (γ : Measure (Measure A)) (hγ : ∀ᵐ m ∂γ, m univ < ⊤) (I : Finset (MeasurableRegion A)) :
      γ.map (fun m => fun S : I => m S.1.1) =
        (γ.map (fun m => fun S : I => m.real S.1.1)).map
          (fun x : I → ℝ => fun S : I => ENNReal.ofReal (x S)) := by
    have hReal : Measurable (fun m : Measure A => fun S : I => m.real S.1.1) :=
      measurable_pi_lambda _ (fun S => (Measure.measurable_coe S.1.2).ennreal_toReal)
    have hOfReal : Measurable (fun x : I → ℝ => fun S : I => ENNReal.ofReal (x S)) :=
      measurable_pi_lambda _ (fun S => (measurable_pi_apply S).ennreal_ofReal)
    rw [Measure.map_map hOfReal hReal]
    apply Measure.map_congr
    filter_upwards [hγ] with m hm
    funext S
    exact (ENNReal.ofReal_toReal (((measure_mono (subset_univ S.1.1)).trans_lt hm).ne)).symm
  apply randomMeasure_law_eq_of_finite_evaluations μ ν
  intro I
  rw [hrecover μ hμ I,hrecover ν hν I,h I]

end ProphetSecretary.Probability
