import Mathlib.Probability.Martingale.Basic
import Mathlib.MeasureTheory.Integral.Prod

/-!
# Conditioning an independent product on its first coordinate

The conditional expectation is the integral against the fresh second-coordinate law.
It is proved by its measurable-set integral characterization and actual product Fubini.
This supplies conditional centering when an empirical threshold depends on previously
revealed training samples but the next sample is independent and still hidden.
-/

open MeasureTheory Set

namespace ProphetSecretary.Probability

variable {A B : Type*} [mA : MeasurableSpace A] [mB : MeasurableSpace B]
    (μ : Measure A) (ν : Measure B) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]

/-- The information generated by the first coordinate, without observing the second. -/
abbrev firstCoordinateSigma : MeasurableSpace (A × B) := mA.comap Prod.fst

lemma firstCoordinateSigma_le : firstCoordinateSigma (A := A) (B := B) ≤ (inferInstance : MeasurableSpace (A × B)) :=
  measurable_fst.comap_le

/-- Integrating the independent fresh coordinate is the actual conditional expectation. -/
theorem condExp_prod_firstCoordinate {F : A × B → ℝ} (hFm : Measurable F)
    (hFI : Integrable F (μ.prod ν)) :
    (μ.prod ν)[F | firstCoordinateSigma (A := A) (B := B)] =ᵐ[μ.prod ν]
      (fun z => ∫ b, F (z.1, b) ∂ν) := by
  let m := firstCoordinateSigma (A := A) (B := B)
  let G : A × B → ℝ := fun z => ∫ b, F (z.1, b) ∂ν
  have hm : m ≤ mA.prod mB := firstCoordinateSigma_le
  have hgA : StronglyMeasurable (fun a => ∫ b, F (a, b) ∂ν) :=
    hFm.stronglyMeasurable.integral_prod_right'
  have hGm : StronglyMeasurable[m] G := by
    letI : MeasurableSpace (A × B) := m
    have hfst : Measurable (Prod.fst : A × B → A) := Measurable.of_comap_le le_rfl
    exact hgA.comp_measurable hfst
  have hGI : Integrable G (μ.prod ν) := hFI.integral_prod_left.comp_fst ν
  have hCE : G =ᵐ[μ.prod ν] (μ.prod ν)[F | m] := by
    apply ae_eq_condExp_of_forall_setIntegral_eq hm hFI
      (fun _ _ _ => hGI.integrableOn) ?_ hGm.aestronglyMeasurable
    intro E hE _hfinite
    obtain ⟨s, hs, he⟩ := MeasurableSpace.measurableSet_comap.mp hE
    have hset : E = s ×ˢ (univ : Set B) := by
      rw [← he]
      ext z
      simp
    rw [hset, setIntegral_prod G hGI.integrableOn, setIntegral_prod F hFI.integrableOn]
    simp only [Measure.restrict_univ, G, integral_const, probReal_univ, one_smul]
  exact hCE.symm

/-- Transfer the same fresh-coordinate formula through an actual product-law pair.
The observed sigma algebra is generated only by `Y`. -/
theorem condExp_productPair {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (ρ : Measure Ω) [IsProbabilityMeasure ρ] {Y : Ω → A} {X : Ω → B}
    (hpair : MeasurePreserving (fun ω => (Y ω, X ω)) ρ (μ.prod ν))
    {F : A × B → ℝ} (hFm : Measurable F) (hFI : Integrable F (μ.prod ν)) :
    ρ[(fun ω => F (Y ω, X ω)) | mA.comap Y] =ᵐ[ρ]
      (fun ω => ∫ b, F (Y ω, b) ∂ν) := by
  let G : A → ℝ := fun a => ∫ b, F (a, b) ∂ν
  have hY : MeasurePreserving Y ρ μ := measurePreserving_fst.comp hpair
  have hinfo : mA.comap Y ≤ mΩ := hY.measurable.comap_le
  have hGA : StronglyMeasurable G := hFm.stronglyMeasurable.integral_prod_right'
  have hG : StronglyMeasurable[mA.comap Y] (fun ω => G (Y ω)) := by
    letI : MeasurableSpace Ω := mA.comap Y
    have hmY : Measurable Y := Measurable.of_comap_le le_rfl
    exact hGA.comp_measurable hmY
  have hGI : Integrable (fun ω => G (Y ω)) ρ := hY.integrable_comp_of_integrable hFI.integral_prod_left
  have hCE : (fun ω => G (Y ω)) =ᵐ[ρ] ρ[(fun ω => F (Y ω, X ω)) | mA.comap Y] := by
    apply ae_eq_condExp_of_forall_setIntegral_eq hinfo (hpair.integrable_comp_of_integrable hFI)
      (fun _ _ _ => hGI.integrableOn) ?_ hG.aestronglyMeasurable
    intro E hE _hfinite
    obtain ⟨s, hs, he⟩ := MeasurableSpace.measurableSet_comap.mp hE
    have hpre : (fun ω => (Y ω, X ω)) ⁻¹' (s ×ˢ (univ : Set B)) = E := by
      rw [← he]
      ext ω
      simp
    have hFmap := setIntegral_map (μ := ρ) (g := fun ω => (Y ω, X ω))
      (hs.prod MeasurableSet.univ) hFm.aestronglyMeasurable hpair.measurable.aemeasurable
    rw [hpair.map_eq, hpre] at hFmap
    have hFub := setIntegral_prod F (s := s) (t := (univ : Set B)) hFI.integrableOn
    simp only [setIntegral_univ] at hFub
    have hGmap := setIntegral_map (μ := ρ) (g := Y) hs hGA.aestronglyMeasurable hY.measurable.aemeasurable
    rw [hY.map_eq, he] at hGmap
    exact hGmap.symm.trans (hFmap.symm.trans hFub).symm
  exact hCE.symm

end ProphetSecretary.Probability
